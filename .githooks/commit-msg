#!/bin/sh
# 커밋 메시지에서 AI 공동 작성자 트레일러를 제거한다.
# 작성자 표기는 기존 Git 설정값만 사용한다(CLAUDE.md 커밋 메시지 규칙).
msg="$1"
tmp="$msg.stripped"

sed -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*noreply@anthropic\.com/d' \
    -e '/^[[:space:]]*🤖 Generated with \[Claude Code\]/d' "$msg" \
  | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' > "$tmp"

mv "$tmp" "$msg"
